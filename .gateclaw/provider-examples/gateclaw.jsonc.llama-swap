{
  "$schema": "https://opencode.ai/schema/config.json",
  "provider": "llama-swap",
  "endpoint": "http://localhost:8888",
  "models": {
    "default": "llama-3.2-90b-vision",
    "fast": "llama-3.1-8b",
    "quality": "qwen-2.5-72b",
  },
  "context_limit": 262144,
  "temperature": 0.7,
  "max_tokens": 8192,
  "stream": true,
  "_comment": "llama-swap provider with model routing - adjusts context limits per model"
}
