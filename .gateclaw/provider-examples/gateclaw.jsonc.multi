{
  "$schema": "https://opencode.ai/schema/config.json",
  "provider": "multi",
  "failover": [
    {
      "provider": "llama-swap",
      "endpoint": "http://localhost:8888",
      "models": { "default": "llama-3.2-90b-vision" },
      "priority": 1,
    },
    {
      "provider": "ollama",
      "endpoint": "http://localhost:11434",
      "models": { "default": "llama3.2:latest" },
      "priority": 2,
    },
    {
      "provider": "anthropic",
      "api_key": "ANT_HOSTED_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
      "models": { "default": "claude-sonnet-4-20250514" },
      "priority": 3,
    },
  ],
  "context_limit": 262144,
  "temperature": 0.7,
  "max_tokens": 8192,
  "stream": true,
  "_comment": "Multi-provider failover chain - tries local first, falls back to cloud"
}
