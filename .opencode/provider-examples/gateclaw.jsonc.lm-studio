{
  "$schema": "https://opencode.ai/schema/config.json",
  "provider": "openai-compatible",
  "endpoint": "http://localhost:1234/v1",
  "api_key": "lm-studio",
  "models": {
    "default": "local-model",
  },
  "context_limit": 65536,
  "temperature": 0.7,
  "max_tokens": 4096,
  "stream": true,
  "_comment": "LM Studio GUI - loads GGUF models, auto-starts local server"
}
