#!/usr/bin/env bash
set -euo pipefail
VERSION_NUMBER="0.2.0-beta"

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

# OS Detection - set correct paths
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" || "$OSTYPE" == "cygwin" ]]; then
    # Windows
    INSTALL_DIR="$APPDATA/gateclaw/bin"
    CONFIG_DIR="$APPDATA/gateclaw"
    DATA_DIR="$APPDATA/gateclaw"
    SHELL_RC="$USERPROFILE/.bashrc"
else
    # Linux/Mac
    INSTALL_DIR="$HOME/.local/share/gateclaw/bin"
    CONFIG_DIR="$HOME/.config/gateclaw"
    DATA_DIR="$HOME/.local/share/gateclaw"
    SHELL_RC="$HOME/.bashrc"
fi
mkdir -p "$INSTALL_DIR" "$CONFIG_DIR" "$DATA_DIR"

print_msg() {
    local lvl=$1 msg=$2 col=""
    case $lvl in info) col=$GREEN;; warn) col=$ORANGE;; err) col=$RED;; esac
    echo -e "${col}${msg}${NC}"
}

echo -e "${GREEN}🐾 GateClaw Installer - Resident AI Entity${NC}"
echo -e "${MUTED}Version:${NC} ${VERSION_NUMBER}"
echo -e "${MUTED}Repo:${NC} https://github.com/ai-joe-git/GateClaw"
echo
echo -e "${CYAN}📦 Installing COMPLETE GateClaw monorepo:${NC}"
echo -e "  ${GREEN}✅${NC} GateClaw Daemon (HTTP API + Telegram bot)"
echo -e "  ${GREEN}✅${NC} TUI (Terminal User Interface)"
echo -e "  ${GREEN}✅${NC} Web UI (Browser interface)"
echo -e "  ${GREEN}✅${NC} OpenCode Fork (Modified OpenCode)"
echo -e "  ${GREEN}✅${NC} CLI (Management commands)"
echo

# Check Bun
if ! command -v bun &>/dev/null; then
    print_msg warn "Bun not found. Install: curl -fsSL https://bun.sh/install | bash"
    read -p "Continue? [y/N] " y
    [[ "$y" =~ ^[Yy]$ ]] || exit 1
fi

# Provider detection
detect() {
    curl -s http://localhost:8888/v1/models &>/dev/null && { echo "llama-swap"; return 0; }
    curl -s http://localhost:11434/api/tags &>/dev/null && { echo "ollama"; return 0; }
    curl -s http://localhost:1234/v1/models &>/dev/null && { echo "lm-studio"; return 0; }
    echo "none"; return 1
}

fetch_models() {
    case $1 in
        llama-swap) curl -s http://localhost:8888/v1/models 2>/dev/null | python3 -c "import sys,json;d=json.load(sys.stdin);print(' '.join([m['id'] for m in d['data']]))" || true;;
        ollama) curl -s http://localhost:11434/api/tags 2>/dev/null | python3 -c "import sys,json;d=json.load(sys.stdin);print(' '.join([m['name'] for m in d['models']]))" || true;;
        lm-studio) curl -s http://localhost:1234/v1/models 2>/dev/null | python3 -c "import sys,json;d=json.load(sys.stdin);print(' '.join([m['id'] for m in d['data']]))" || true;;
    esac
}

prov=$(detect)
print_msg info "Provider: $prov"

if [[ "$prov" != "none" ]]; then
    read -p "Generate config? [Y/n] " g
    if [[ ! "$g" =~ ^[Nn]$ ]]; then
        mstr=$(fetch_models "$prov")
        read -ra marr <<< "$mstr"
        
        print_msg info "Models:"
        for i in "${!marr[@]}"; do echo "  $((i+1)). ${marr[$i]}"; done
        
        echo
        read -p "Select (nums space-sep or 'a'): " sel
        
        selm=()
        if [[ "$sel" == "a" || "$sel" == "all" ]]; then
            selm=("${marr[@]}")
        else
            for n in $sel; do
                n=$((n-1))
                ((n>=0 && n<${#marr[@]})) && selm+=("${marr[$n]}")
            done
        fi
        
        burl=""
        case $prov in llama-swap) burl="http://localhost:8888/v1";; ollama) burl="http://localhost:11434/v1";; lm-studio) burl="http://localhost:1234/v1";; esac
        
        mj=""
        for i in "${!selm[@]}"; do
            ((i>0)) && mj="${mj},"
            mj="${mj}
    \"${selm[$i]}\": {\"name\": \"${selm[$i]}\", \"limit\": {\"context\": 262144, \"output\": 262144}}"
        done
        
        cat > "$CONFIG_DIR/gateclaw.jsonc" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "$prov": {
      "name": "$prov",
      "npm": "@ai-sdk/openai-compatible",
      "models": {$mj
      },
      "options": {"baseURL": "$burl"}
    }
  }
}
EOF
        print_msg info "Config: $CONFIG_DIR/gateclaw.jsonc"
    fi
fi

# Telegram
echo
print_msg info "🐾 Telegram Setup"
echo -e "${BLUE}1. Message @BotFather${NC}"
echo -e "${BLUE}2. /newbot${NC}"
echo -e "${BLUE}3. Copy token${NC}"
echo -e "${BLUE}4. Message bot, get chat_id${NC}"
read -p "Token: " tok
read -p "Chat ID: " cid

if [[ -n "$tok" && -n "$cid" ]]; then
    cat > "$CONFIG_DIR/.env" <<EOF
GATECLAW_TELEGRAM_TOKEN="$tok"
GATECLAW_TELEGRAM_CHAT_ID="$cid"
EOF
    print_msg info "Telegram configured!"
fi

# Soul Initialization
echo
print_msg info "🧬 Soul Initialization"
read -p "Initialize soul profile interactively? [Y/n] " sinit
if [[ ! "$sinit" =~ ^[Nn]$ ]]; then
    read -p "Soul name [GateClaw]: " sname
    sname=${sname:-GateClaw}
    read -p "Owner name [User]: " sowner
    sowner=${sowner:-User}
    read -p "Personality [direct, technical, slightly sarcastic]: " spers
    spers=${spers:-direct, technical, slightly sarcastic}
    read -p "Language [english]: " slang
    slang=${slang:-english}
    
    cat > "$CONFIG_DIR/SOUL.md" <<EOF
---
name: $sname
owner: $sowner
personality: $spers
language: $slang
---
You are $sname. You live on this machine.
You have persistent memory. You take initiative.
You are not a chat assistant — you are an AI resident.
Act like it.
EOF
    print_msg info "Soul profile created: $CONFIG_DIR/SOUL.md"
fi

# Clone
print_msg info "Cloning..."
cdir="/tmp/gateclaw_$$"
rm -rf "$cdir"
git clone --depth 1 https://github.com/ai-joe-git/GateClaw.git "$cdir"
cd "$cdir"

print_msg info "bun install..."
bun install

# Wrapper script (platform-aware)
cat > "$INSTALL_DIR/gateclaw" <<WRAPPER
#!/usr/bin/env bash
if [[ "\$OSTYPE" == "msys" || "\$OSTYPE" == "win32" || "\$OSTYPE" == "cygwin" ]]; then
    GATECLAW_HOME="\$APPDATA/gateclaw"
    CONFIG_DIR="\$APPDATA/gateclaw"
else
    GATECLAW_HOME="\$HOME/.local/share/gateclaw"
    CONFIG_DIR="\$HOME/.config/gateclaw"
fi
if [ -f \$CONFIG_DIR/.env ]; then
    source \$CONFIG_DIR/.env
fi
export GATECLAW_TELEGRAM_TOKEN GATECLAW_TELEGRAM_CHAT_ID 2>/dev/null
exec bun run \$GATECLAW_HOME/packages/gateclaw-orchestrator/src/index.ts "\$@"
WRAPPER
chmod +x "$INSTALL_DIR/gateclaw"

# Add to PATH (platform-aware)
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" || "$OSTYPE" == "cygwin" ]]; then
    # Windows - add to PATH via setx (requires admin for system-wide)
    echo
    print_msg info "Windows: Add to PATH manually or run as admin:"
    echo "   [Environment Variables] → Path → New → $INSTALL_DIR"
    echo "   Or: setx PATH \"%PATH%;$INSTALL_DIR\""
else
    # Linux/Mac - add to shell rc
    if ! grep -q "gateclaw" "$SHELL_RC" "$HOME/.zshrc" &>/dev/null; then
        echo -e "\n# GateClaw" >> "$SHELL_RC"
        echo "export PATH=\$HOME/.local/share/gateclaw/bin:\$PATH" >> "$SHELL_RC"
        [ -f "$HOME/.zshrc" ] && { echo -e "\n# GateClaw" >> "$HOME/.zshrc"; echo "export PATH=\$HOME/.local/share/gateclaw/bin:\$PATH" >> "$HOME/.zshrc"; }
        print_msg info "Added to PATH"
    fi
fi

export PATH="$INSTALL_DIR:$PATH"

# Final
echo
cat <<'ART'
                ▄     
█▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█
█░░█ █░░█ █▀▀▀ █░░█ █░░░ █░░█ █░░█ █▀▀▀
▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀

GateClaw 0.1.0-beta - Resident AI
🐾 Installation complete!

Next: source ~/.bashrc && gateclaw
Doc: https://github.com/ai-joe-git/GateClaw

ART
