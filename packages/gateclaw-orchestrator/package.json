{
  "name": "@gateclaw/monorepo",
  "version": "0.2.0-beta",
  "type": "module",
  "description": "Resident AI Entity - Full Stack (Daemon + TUI + Telegram + Web UI + OpenCode Fork)",
  "keywords": [
    "ai",
    "assistant",
    "resident",
    "local",
    "telegram",
    "tui",
    "opencode",
    "monorepo"
  ],
  "author": "GateClaw Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-joe-git/GateClaw.git"
  },
  "bugs": {
    "url": "https://github.com/ai-joe-git/GateClaw/issues"
  },
  "homepage": "https://github.com/ai-joe-git/GateClaw#readme",
  "private": true,
  "note": "This is a monorepo - install via git clone, not npm. See install scripts in root directory.",
  "bin": {
    "gateclaw": "./bin/gateclaw"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "mcp": "bun run src/mcp.ts",
    "typecheck": "tsgo --noEmit",
    "gate": "bun run src/cli.ts",
    "web": "bun run src/cli.ts web",
    "tui": "bun run src/cli.ts tui",
    "daemon": "bun run src/cli.ts daemon"
  },
  "dependencies": {
    "@grammyjs/menu": "1.3.1",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@opencode-ai/sdk": "1.2.26",
    "better-sqlite3": "12.8.0",
    "dotenv": "17.3.1",
    "grammy": "1.41.1",
    "gray-matter": "^4.0.3",
    "hono": "4.10.7",
    "https-proxy-agent": "8.0.0",
    "jsonc-parser": "3.3.1",
    "socks-proxy-agent": "9.0.0",
    "telegram-markdown-v2": "0.0.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260313.1",
    "typescript": "5.9.3"
  }
}
